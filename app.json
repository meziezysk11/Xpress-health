{
  "expo": {
    "name": "Achievers Professionals",
    "slug": "achievers-professionals",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "achieversprofessionals",
    "backgroundColor": "#F4F7FB",
    "splash": {
      "backgroundColor": "#0D2D5E",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.achieversprofessionals.app"
    },
    "android": {
      "package": "com.achieversprofessionals.app",
      "edgeToEdgeEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos so you can set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "92be100c-6e42-49e1-8f43-a62e2919d7c9"
      }
    },
    "owner": "chimezie"
  }
}
